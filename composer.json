{
    "name": "mmaunze/portfolio",
    "description": "Portfolio pessoal de Meldo Leonardo Maúnze",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "phpmailer/phpmailer": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "files": [
            "config/bootstrap.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
